<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <tax_sync>
            <general>
                <enabled>1</enabled>
                <sync_frequency>weekly</sync_frequency>
                <cron_schedule>0 3 * * 1</cron_schedule>
                <api_source>euvatrates</api_source>
                <include_non_eu>1</include_non_eu>
            </general>
            <rules>
                <create_rules>1</create_rules>
            </rules>
            <notifications>
                <email_enabled>1</email_enabled>
                <admin_notification>1</admin_notification>
            </notifications>
        </tax_sync>
    </default>
</config>
